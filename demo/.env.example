# ---------------------------------------------------------------------------
# HomeSense voice-agent demo - environment template
# Copy to .env.local and fill in. NEVER commit .env.local.
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# --- Required: LiveKit project credentials ---------------------------------
# From https://cloud.livekit.io -> your project -> Settings -> Keys
# `lk app env -w .env.local` will also write these for you.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Models (LiveKit Inference) --------------------------------------------
# These are "provider/model" strings resolved and billed through your LiveKit
# project, so no provider API keys are required. Override only to experiment.
# STT_MODEL=deepgram/nova-3
# LLM_MODEL=openai/gpt-4.1-mini
# TTS_MODEL=cartesia/sonic-2

# --- Optional: bring your own OpenAI key ------------------------------------
# Only needed if you switch agent.py to the openai plugin instead of
# LiveKit Inference. Leave unset for the default path.
# OPENAI_API_KEY=

# --- Optional: live phone beat ----------------------------------------------
# The demo account HS-10042 ships with a placeholder phone number. Set this to
# your mobile and the agent greets you by name when you call your LiveKit phone
# number over SIP. It is also the main demo dataset, so the whole demo script
# works over the phone. Unset -> the account falls back to an unroutable
# +10000000000 and matches no real caller.
# No real number is ever committed to customers.json.
# PRESENTER_PHONE=+1XXXXXXXXXX

# Inbound SIP rooms are named with this prefix by the dispatch rule.
# SIP_ROOM_PREFIX=call-

# --- Optional: read-only lookups over MCP -----------------------------------
# Run `uv run mcp_server.py` in another terminal, then start the agent with
# USE_MCP=1. The same backend functions are served over streamable HTTP.
# USE_MCP=1
# MCP_URL=http://127.0.0.1:8770/mcp
MCP_TOKEN=homesense-dev-token
# MCP_HOST=127.0.0.1
# MCP_PORT=8770

# --- Optional: turn-taking / session guards ---------------------------------
# Seconds of silence before the agent checks whether the caller is still there.
# USER_AWAY_TIMEOUT=15
# Hard cap on a single call, in seconds.
# MAX_SESSION_SECONDS=900

# --- Optional: real warm transfer over SIP -----------------------------------
# Set BOTH to dial a human specialist into the call. If either is missing, the
# agent falls back to the simulated human console (prints a HANDOFF block and
# writes data/handoffs.jsonl) - which is what the demo uses by default.
# TRANSFER_PHONE_NUMBER=+14155550199
# SIP_OUTBOUND_TRUNK_ID=ST_xxxxxxxxxxxx
